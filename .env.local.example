# LINE LIFF ID (LINE Developers Console で取得)
# 未設定の場合はモックモードで動作します
NEXT_PUBLIC_LIFF_ID=

# microCMS (https://microcms.io で取得)
# 未設定の場合はモックデータで動作します
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Supabase (https://supabase.com で取得)
# 課題ページのコメント機能で使用。未設定の場合はコメント機能が無効化されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LINE Messaging API (役員グループ通知用)
# 住民から要望/質問が投稿された時に、役員の LINE グループにプッシュ通知する。
# どちらかでも未設定なら通知は静かにスキップされる (アプリ自体は動作する)。
# 設定手順は docs/admin-manual.md の 8-A-0-A 章を参照。
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MODERATION_GROUP_ID=
