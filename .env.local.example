# LINE LIFF ID (LINE Developers Console で取得)
# 未設定の場合はモックモードで動作します
NEXT_PUBLIC_LIFF_ID=

# microCMS (https://microcms.io で取得)
# 未設定の場合はモックデータで動作します
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Supabase (https://supabase.com で取得)
# 課題ページのコメント機能で使用。未設定の場合はコメント機能が無効化されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
