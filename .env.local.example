# LINE LIFF ID (LINE Developers Console で取得)
# 未設定の場合はモックモードで動作します
NEXT_PUBLIC_LIFF_ID=

# microCMS (https://microcms.io で取得)
# 未設定の場合はモックデータで動作します
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Supabase (https://supabase.com で取得)
# 課題ページのコメント機能、清掃活動のRSVPで使用。未設定の場合は該当機能が無効化されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (会員台帳・会費・入金の役員ダッシュボードで使用)
# サーバー専用、絶対にクライアントに露出させないこと。Vercel 環境変数では Sensitive ON 必須。
# 未設定の場合は役員ダッシュボードが利用不可になります
SUPABASE_SERVICE_ROLE_KEY=
