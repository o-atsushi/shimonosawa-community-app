# LINE LIFF ID (LINE Developers Console で取得)
# 未設定の場合はモックモードで動作します
NEXT_PUBLIC_LIFF_ID=

# microCMS (https://microcms.io で取得)
# 未設定の場合はモックデータで動作します
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Supabase (https://supabase.com で取得)
# 課題ページのコメント機能で使用。未設定の場合はコメント機能が無効化されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LINE Messaging API (役員グループ通知用)
# 住民から要望/質問が投稿された時に、役員の LINE グループにプッシュ通知する。
# どちらかでも未設定なら通知は静かにスキップされる (アプリ自体は動作する)。
# 設定手順は docs/admin-manual.md の 8-A-0-A 章を参照。
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MODERATION_GROUP_ID=

# LINE 一斉送信スキル (scripts/line-broadcast.mjs) のテスト送信先 = 自分の LINE userId (U から始まる 33 文字)
# アプリ本体では使わない。ローカルの .env にだけ書く
LINE_TEST_TO=

# Supabase の service role key (secret)。サーバー専用、NEXT_PUBLIC_ を付けないこと。
# AI相談の質問ログ (chat_logs) と AI用資料 (chat_knowledge) は住民に見せないため、このキーでのみ読み書きする。
SUPABASE_SERVICE_ROLE_KEY=

# AI相談 (/chat)。未設定なら AI相談ページは「準備中」と表示される。
# CHAT_PROVIDER: anthropic (Claude API、既定) または bedrock (Amazon Bedrock)
CHAT_PROVIDER=anthropic
# Claude API を使う場合: Anthropic Console で発行した API キー
ANTHROPIC_API_KEY=
# Bedrock を使う場合: AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# モデルの自動切り替え: auto (既定) = まず CHAT_FAST_MODEL が答え、自信が無い時だけ CHAT_MODEL が答え直す
#                       off = 常に CHAT_MODEL だけで答える
CHAT_ROUTING=auto
# 自動切り替えで最初に答える安いモデル
CHAT_FAST_MODEL=claude-haiku-5-5
# 上位のモデル (費用が大きく変わる。docs/admin-manual.md の AI相談の章を参照)
# claude-opus-5-5 (既定・高品質) / claude-sonnet-5-5 / claude-haiku-5-5 (最安)
CHAT_MODEL=claude-opus-5-5
# 考える深さ: low (既定) / medium / high。上げるほど丁寧だが高くなる
CHAT_EFFORT=low
# 回覧板の写真の文字起こしに使うモデル (未設定なら CHAT_MODEL)。1 回覧板につき 1 回だけ使う
# CIRCULATION_TEXT_MODEL=claude-haiku-5-5
# 1 人 1 日あたりの質問回数の上限 (既定 20)
CHAT_DAILY_LIMIT=20
# アプリ全体の 1 日の質問回数の上限 (既定 300)。費用が青天井にならないための安全装置
CHAT_GLOBAL_DAILY_LIMIT=300
